{
  "name": "crash-deformer-test",
  "private": true,
  "sideEffects": ["./src/game/kernel/three-trig.ts"],
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "dev_alt": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 5555",
    "build": "node scripts/with-app-env.mjs vite build",
    "build:node": "node scripts/with-app-env.mjs NITRO_PRESET=node-server vite build",
    "start:node": "node .output/server/index.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "build:dev-watch": "node scripts/with-app-env.mjs vite build --mode development --watch",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs --ratchet",
    "check:programs": "node scripts/check-programs.mjs",
    "test": "node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types scripts/run-tests.mjs src/lib/multiplayer/rate-limit.test.ts 'src/lib/submissions/**/*.test.ts' 'src/lib/deploy/**/*.test.ts' 'src/game/**/*.test.ts'",
    "test:game": "node --experimental-strip-types scripts/run-tests.mjs 'src/game/**/*.test.ts'",
    "test:app": "node --experimental-strip-types scripts/run-tests.mjs 'src/game/**/*.test.ts' 'src/lib/multiplayer/**/*.test.ts' 'src/lib/submissions/**/*.test.ts' 'src/lib/deploy/**/*.test.ts' scripts/with-app-env.test.mjs",
    "t": "node --experimental-strip-types scripts/run-tests.mjs",
    "bench": "node scripts/bench-physics.mjs",
    "sweep": "node --experimental-strip-types --no-warnings scripts/crush-sweep.mjs",
    "bake:env": "node scripts/bake-env.mjs",
    "build:kernel": "node scripts/build-skin-kernel.mjs",
    "build:motor": "node scripts/build-motor-worklet.mjs",
    "lint": "oxlint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dimforge/rapier3d-simd": "0.19.3",
    "@electric-sql/pglite": "^0.5.4",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-popover": "^1.1.15",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/router-plugin": "^1.168.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.186.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260610-beta",
    "oxlint": "1.86.0",
    "oxlint-plugin-eslint": "1.86.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
