# Settings for crush.service and crush-deploy.service. Install as the @ENV@ file
# named in the units, owned by root, mode 600. Nothing here is secret but
# SUBMISSIONS_OWNER_TOKEN: the repo is public and fetched without credentials.
# Keep it off git anyway, because the real file describes one particular box.

# What to deploy. Any git URL or a local `git bundle` file works.
CRUSH_REPO=https://github.com/aphix/crash-deformer-test.git
CRUSH_BRANCH=main

# Sub-path the app is built for and served under (both slashes).
APP_BASE=/crush/

# Two unused localhost ports (check with `ss -ltn`): the live server, and the
# throwaway one each new release is health-checked on before it goes live.
PORT=
CRUSH_CHECK_PORT=

# Releases kept on disk, including the live one.
CRUSH_KEEP=3

# Optional; defaults shown. A failed build is retried after attempts x backoff
# minutes and given up after CRUSH_BUILD_TRIES attempts; each health check gives
# up after CRUSH_HEALTH_TIMEOUT seconds.
#CRUSH_BUILD_TRIES=3
#CRUSH_BUILD_BACKOFF_MIN=10
#CRUSH_HEALTH_TIMEOUT=120

# Reads of what players send from the game (benchmark cards, JSON captures,
# flagged replay clips: GET <APP_BASE>api/submissions, or scripts/fetch-submissions.mjs)
# need this as a bearer token. SECRET, 24 characters or more (`openssl rand -hex 32`).
# Unset or short: every read answers 503 (posts still work and are stored in the app
# database under PGLITE_DATA_DIR, which survives deploys).
SUBMISSIONS_OWNER_TOKEN=
