node_modules/
.env
.env.*
dist/
.output/
.nitro/
.tanstack/
build/
*.tsbuildinfo
# Re-downloadable paper PDFs (URLs in .extraResearch/README.md); notes stay tracked.
.extraResearch/papers/*.pdf
# Local benchmark JSON and CPU profiles (scripts/bench-browser.mjs --out/--profile).
.bench/

# QA screenshots stay local (older tracked ones remain)
screenshots/*
!screenshots/.gitkeep

# Rust kernel build output (the committed skin-kernel.wasm is what ships). No trailing slash: under mbx it is a symlink.
kernels/skin/target

# The soundtrack's mp3s are NCS music: licensed for use in the game, not for redistribution, so they never enter this public repo
# (docs/DEPLOY.md, "Music"). The manifest beside them is committed as the reference copy.
public/music/*.mp3
.soundAssetStaging/

# The people's source models (README "Credits"): licensed for use in the game, not for passing on; only their bake is committed.
assets-src/
